  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Yaku.Quests.ChapterObjective
  mission: El peligro invisible
  instruction: Compara las fuentes junto al mirador de la ribera.
  prompt: Inspeccionar recipientes
  conversation: {fileID: 0}
  npc: {fileID: 0}
  interactionTrigger: {fileID: 1529537229}
  question: "\xBFQu\xE9 agua llevar\xEDas a la posta?"
  choices:
  - Recipiente transparente, origen sin verificar.
  - Recipiente del punto de abastecimiento verificado.
  - "Agua del r\xEDo hervida o pasada por un filtro de sedimentos."
  correctChoice: 1
  correctFeedback: El aviso ficticio respalda la fuente evaluada. Hervir, desinfectar o filtrar sedimentos en casa no elimina de forma fiable el mercurio disuelto.
  retryFeedback: "Revisa el aviso de monitoreo. El aspecto y los tratamientos dom\xE9sticos no demuestran seguridad qu\xEDmica."
  observation: "Fuente seleccionada: abastecimiento verificado seg\xFAn el aviso ficticio."
  reward: {fileID: 0}
  distribution: {fileID: 0}
