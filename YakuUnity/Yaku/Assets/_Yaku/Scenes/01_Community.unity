  m_Script: {fileID: 11500000, guid: 3d07892c85c81584383e43290ae02fe2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Yaku.Quests.ChapterObjective
  mission: Atender y orientar
  instruction: "Confirma con Elena c\xF3mo orientar a la familia."
  prompt: "Confirmar orientaci\xF3n con Elena"
  conversation: {fileID: 0}
  npc: {fileID: 179525889}
  interactionTrigger: {fileID: 0}
  question: "\xBFQu\xE9 hacer si una familia sospecha exposici\xF3n a mercurio?"
  choices:
  - Usar los primeros auxilios de la herida como tratamiento.
  - Diagnosticar por lo que vemos.
  - "Buscar orientaci\xF3n profesional y compartir lo observado."
  correctChoice: 2
  correctFeedback: "Elena registra la consulta y orienta a la familia. Los primeros auxilios de una herida no tratan la exposici\xF3n a mercurio."
  retryFeedback: "Cada situaci\xF3n se atiende de forma distinta. Comunica lo observado al personal de salud."
  observation: "El personal de salud orienta ante una sospecha de exposici\xF3n. La ayuda por una herida es una situaci\xF3n diferente."
  reward: {fileID: 0}
  distribution: {fileID: 0}
