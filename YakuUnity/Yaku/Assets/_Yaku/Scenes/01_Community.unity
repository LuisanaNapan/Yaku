  m_Script: {fileID: 11500000, guid: 3d07892c85c81584383e43290ae02fe2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Yaku.Quests.ChapterObjective
  mission: Una comunidad preparada
  instruction: Confirma con Elena el motivo de tus entregas.
  prompt: Confirmar las entregas con Elena
  conversation: {fileID: 0}
  npc: {fileID: 179525889}
  interactionTrigger: {fileID: 0}
  question: "\xBFPor qu\xE9 entregaste esos bidones a Tom\xE1s?"
  choices:
  - "La fuente fue verificada seg\xFAn el aviso ficticio."
  - Cualquier agua que parezca clara sirve.
  - "Los bidones eran los m\xE1s cercanos."
  correctChoice: 0
  correctFeedback: "Elena confirma las tres entregas. Comparar informaci\xF3n ayuda a que los recursos adecuados lleguen a cada familia."
  retryFeedback: Piensa en la evidencia que consultaste en el sendero de la ribera.
  observation: Tres paquetes llegaron a sus destinatarios. La evidencia y las necesidades de las familias guiaron el reparto.
  reward: {fileID: 0}
  distribution: {fileID: 0}
