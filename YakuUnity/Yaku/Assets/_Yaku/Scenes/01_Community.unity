  m_Script: {fileID: 11500000, guid: 3d07892c85c81584383e43290ae02fe2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Yaku.Quests.ChapterObjective
  mission: "Elegir con informaci\xF3n"
  instruction: Compara los tres lotes sobre la mesa.
  prompt: Comparar alternativas de alimento
  conversation: {fileID: 0}
  npc: {fileID: 0}
  interactionTrigger: {fileID: 1220772269}
  question: "\xBFQu\xE9 lote llevar\xE1s a la comunidad?"
  choices:
  - "A \xB7 Sin origen documentado, parece fresco."
  - "B \xB7 Origen documentado y recomendado en la ficha."
  - "C \xB7 Origen conocido, con restricci\xF3n vigente."
  correctChoice: 1
  correctFeedback: "El lote B cumple el aviso de esta simulaci\xF3n."
  retryFeedback: "Volvamos a la ficha. La frescura aparente no descarta mercurio y una restricci\xF3n vigente merece atenci\xF3n."
  observation: "Se eligi\xF3 el lote documentado de acuerdo con el aviso ficticio."
  reward: {fileID: 0}
  distribution: {fileID: 0}
