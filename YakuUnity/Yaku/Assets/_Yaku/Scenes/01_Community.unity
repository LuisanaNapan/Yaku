  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d07892c85c81584383e43290ae02fe2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Yaku.Quests.ChapterObjective
  mission: "Elegir con informaci\xF3n"
  instruction: "Explica a Rosa por qu\xE9 elegiste ese alimento."
  prompt: "Justificar la elecci\xF3n con Rosa"
  conversation: {fileID: 0}
  npc: {fileID: 1701008831}
  interactionTrigger: {fileID: 0}
  question: "\xBFQu\xE9 justifica tu decisi\xF3n?"
  choices:
  - "La cocci\xF3n siempre elimina el mercurio."
  - La ficha vigente respalda la procedencia del lote.
  - "El pescado se ve\xEDa y ol\xEDa bien."
  correctChoice: 1
  correctFeedback: "Rosa reconoce tu decisi\xF3n informada y te entrega un suministro autorizado. En la vida real, verifica los avisos sanitarios de tu zona."
  retryFeedback: "La cocci\xF3n y el aspecto no establecen el contenido de mercurio. Consulta la procedencia y los avisos sanitarios."
  observation: "El mercurio puede acumularse en la cadena alimentaria. La elecci\xF3n se bas\xF3 en procedencia documentada y avisos vigentes."
  reward: {fileID: 11400000, guid: 8a57d0112d7299f469be702822d9d870, type: 2}
  distribution: {fileID: 0}
