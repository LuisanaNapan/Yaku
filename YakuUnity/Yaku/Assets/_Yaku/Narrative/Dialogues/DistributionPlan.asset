  m_Script: {fileID: 11500000, guid: a01d3e3d4711f0840936519543a8ff99, type: 3}
  m_Name: DistributionPlan
  m_EditorClassIdentifier: Assembly-CSharp::Yaku.Dialogue.DialogueData
  speaker: Elena
  portrait: {fileID: 0}
  lines:
  - "El almac\xE9n reserv\xF3 tres paquetes. Tom\xE1s necesita dos bidones de la fuente verificada; Rosa recibir\xE1 alimento documentado."
  - "Trae a la posta un paquete b\xE1sico. Revisa el progreso de las tres entregas y regresa conmigo al terminar."
