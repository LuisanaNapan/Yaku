  m_Script: {fileID: 11500000, guid: a01d3e3d4711f0840936519543a8ff99, type: 3}
  m_Name: FoodBriefing
  m_EditorClassIdentifier: Assembly-CSharp::Yaku.Dialogue.DialogueData
  speaker: Rosa
  portrait: {fileID: 0}
  lines:
  - "Quiero preparar comida para las familias. Cerca de mi casa dej\xE9 una ficha con recomendaciones."
  - "El metilmercurio puede acumularse en los peces. Algunos depredadores acumulan m\xE1s al comer otros peces; por eso importan la especie, el origen y los avisos vigentes."
