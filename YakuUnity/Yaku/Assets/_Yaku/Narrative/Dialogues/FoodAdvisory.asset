  m_Script: {fileID: 11500000, guid: a01d3e3d4711f0840936519543a8ff99, type: 3}
  m_Name: FoodAdvisory
  m_EditorClassIdentifier: Assembly-CSharp::Yaku.Dialogue.DialogueData
  speaker: "Ficha de consumo \xB7 Simulaci\xF3n"
  portrait: {fileID: 0}
  lines:
  - "Lugar A: origen sin identificar. Lugar B: lote documentado y recomendado en el aviso ficticio. Lugar C: aviso vigente de restricci\xF3n."
  - "En la vida real consulta recomendaciones actualizadas de las autoridades sanitarias. El olor, la apariencia y la cocci\xF3n no indican si un pescado contiene mercurio."
