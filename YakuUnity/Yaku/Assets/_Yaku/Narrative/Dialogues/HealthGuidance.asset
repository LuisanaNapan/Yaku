  m_Script: {fileID: 11500000, guid: a01d3e3d4711f0840936519543a8ff99, type: 3}
  m_Name: HealthGuidance
  m_EditorClassIdentifier: Assembly-CSharp::Yaku.Dialogue.DialogueData
  speaker: Elena
  portrait: {fileID: 0}
  lines:
  - "Me encargo de evaluar la herida de Tom\xE1s. Gracias por avisar y acompa\xF1arlo. Trae el paquete de apoyo que indica la ficha de la posta."
  - "Para la otra familia, anota qu\xE9 ocurri\xF3, cu\xE1ndo y d\xF3nde. Una sospecha de exposici\xF3n se consulta con el personal de salud y sigue la orientaci\xF3n oficial."
